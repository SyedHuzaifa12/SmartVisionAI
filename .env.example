# Google Gemini API key (required). Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional, defaults to gemini-flash-latest).
# If this 404s, run the model-listing command in the README to see what
# your API key currently supports, then set the exact name here.
GEMINI_MODEL=gemini-flash-latest

# Path to the Tesseract OCR binary (optional).
# Required on Windows if Tesseract isn't on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR (optional, defaults to INFO)
LOG_LEVEL=INFO

# Confidence gating thresholds (0.0-1.0, optional). Default to 0.0 (gate off)
# because this model self-reports confidence near 0 even for clear images -
# raise these only if you've verified the signal is meaningful for your
# traffic. See src/guardrails/confidence.py.
SCENE_CONFIDENCE_THRESHOLD=0.0
HAZARD_CONFIDENCE_THRESHOLD=0.0
OCR_CONFIDENCE_THRESHOLD=0.4

# Per-browser-session rate limit (optional) - protects a shared free-tier API
# key from rapid repeated clicks in one visit. See src/utils/rate_limiter.py.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# Upload guardrails (optional) - reject oversized/corrupted/pathologically
# large images before they reach OCR or Gemini. See src/utils/image_utils.py.
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION_PX=6000
