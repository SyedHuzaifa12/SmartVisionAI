# Google Gemini API key (required). Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional, defaults to gemini-flash-latest).
# If this 404s, run the model-listing command in the README to see what
# your API key currently supports, then set the exact name here.
GEMINI_MODEL=gemini-flash-latest

# Path to the Tesseract OCR binary (optional).
# Required on Windows if Tesseract isn't on PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR (optional, defaults to INFO)
LOG_LEVEL=INFO

# Confidence gating thresholds (0.0-1.0, optional). Below these, a response
# is replaced with a graceful "please recapture" message (scene) or an
# escalated hazard verdict / warning banner (hazard, OCR) instead of being
# shown as-is. See src/guardrails/confidence.py.
SCENE_CONFIDENCE_THRESHOLD=0.5
HAZARD_CONFIDENCE_THRESHOLD=0.5
OCR_CONFIDENCE_THRESHOLD=0.4
